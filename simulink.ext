    drawCube(
        0.88f, 2.28f, -1.35f,
        0.05f, 0.55f, 0.60f,
        0.20f, 0.60f, 0.82f
    );

    // Wheels
    drawWheel(
        -1.0f,
        0.40f,
        1.35f
    );

    drawWheel(
        1.0f,
        0.40f,
        1.35f
    );

    drawWheel(
        -1.0f,
        0.40f,
        -1.35f
    );

    drawWheel(
        1.0f,
        0.40f,
        -1.35f
    );
}

// ============================================================
// PASSENGER COACH
// ============================================================

void drawCoachModel()
{
    drawCube(
        0.0f, 0.70f, 0.0f,
        2.0f, 0.30f, 4.4f,
        0.10f, 0.10f, 0.12f
    );

    drawCube(
        0.0f, 1.60f, 0.0f,
        1.9f, 1.55f, 4.1f,
        0.92f, 0.92f, 0.94f
    );

    drawCube(
        0.0f, 2.48f, 0.0f,
        2.0f, 0.22f, 4.2f,
        0.72f, 0.72f, 0.75f
    );

    for (
        float z = -1.3f;
        z <= 1.3f;
        z += 0.85f
    )
    {
        drawCube(
            -0.96f, 1.82f, z,
            0.04f, 0.55f, 0.50f,
            0.20f, 0.60f, 0.85f
        );

        drawCube(
            0.96f, 1.82f, z,
            0.04f, 0.55f, 0.50f,
            0.20f, 0.60f, 0.85f
        );
    }

    drawWheel(
        -1.0f,
        0.40f,
        1.25f
    );

    drawWheel(
        1.0f,
        0.40f,
        1.25f
    );

    drawWheel(
        -1.0f,
        0.40f,
        -1.25f
    );

    drawWheel(
        1.0f,
        0.40f,
        -1.25f
    );
}

// ============================================================
// TRAIN ON TRACK
// ============================================================

void drawTrainUnit(
    float distance,
    bool locomotive
)
{
    Vec2 position =
        sampleTrackPosition(
            distance
        );

    Vec2 tangent =
        sampleTrackTangent(
            distance
        );

    float angle =
        atan2f(
            tangent.x,
            tangent.z
        ) * 180.0f / PI;

    glPushMatrix();

    glTranslatef(
        position.x,
        0.2f,
        position.z
    );

    glRotatef(
        angle,
        0.0f,
        1.0f,
        0.0f
    );

    if (locomotive)
    {
        drawLocomotiveModel();
    }
    else
    {
        drawCoachModel();
    }

    glPopMatrix();
}

void drawTrain()
{
    drawTrainUnit(
        trainDistance,
        true
    );

    drawTrainUnit(
        trainDistance - 5.8f,
        false
    );

    drawTrainUnit(
        trainDistance - 10.8f,
        false
    );
}

// ============================================================
// STATION TEXT
// ============================================================

void drawText3D(
    float x,
    float y,
    float z,
    const char* text
)
{
    glDisable(GL_LIGHTING);

    glColor3f(
        0.05f,
        0.05f,
        0.05f
    );

    glRasterPos3f(
        x,
        y,
        z
    );

    while (*text)
    {
        glutBitmapCharacter(
            GLUT_BITMAP_HELVETICA_18,
            *text
        );

        text++;
    }

    glEnable(GL_LIGHTING);
}

// ============================================================
// STATION
// ============================================================

void drawStation(
    const Station& station
)
{
    // Platform
    drawCube(
        station.x,
        0.16f,
        station.z,

        station.sizeX,
        0.35f,
        station.sizeZ,

        0.93f,
        0.93f,
        0.93f
    );

    // Building
    drawCube(
        station.x,
        1.15f,
        station.z,

        2.8f,
        1.8f,
        2.0f,

        0.80f,
        0.25f,
        0.10f
    );

    // Roof
    drawCube(
        station.x,
        2.18f,
        station.z,

        3.2f,
        0.22f,
        2.3f,

        0.35f,
        0.12f,
        0.06f
    );

    drawText3D(
        station.x - 2.2f,
        3.0f,
        station.z,

        station.name
    );
}

void drawStations()
{
    for (
        int i = 0;
        i < 4;
        i++
    )
    {
        drawStation(
            stations[i]
        );
    }
}

// ============================================================
// TREES
// ============================================================

void drawTree(float x, float z)
{
    drawCube(
        x,
        0.9f,
        z,

        0.5f,
        1.8f,
        0.5f,

        0.35f,
        0.18f,
        0.06f
    );

    glPushMatrix();

    glTranslatef(
        x,
        2.8f,
        z
    );

    glColor3f(
        0.05f,
        0.55f,
        0.08f
    );

    glutSolidCone(
        1.4f,
        3.0f,
        16,
        8
    );

    glPopMatrix();
}

void drawEnvironment()
{
    drawTree(-72.0f, 42.0f);
    drawTree(70.0f, 42.0f);

    drawTree(-70.0f, 12.0f);
    drawTree(72.0f, 8.0f);

    drawTree(-70.0f, -22.0f);
    drawTree(72.0f, -26.0f);

    drawTree(-66.0f, -48.0f);
    drawTree(70.0f, -47.0f);
}

// ============================================================
// CAMERA
// ============================================================

void setCamera()
{
    Vec2 position =
        sampleTrackPosition(
            trainDistance
        );

    Vec2 tangent =
        sampleTrackTangent(
            trainDistance
        );

    float panX =
        camPanX[cameraMode];

    float panZ =
        camPanZ[cameraMode];

    float lift =
        camLift[cameraMode];

    // ========================================================
    // CAMERA 1 - CHASE
    // ========================================================

    if (cameraMode == 0)
    {
        gluLookAt(

            // Camera
            position.x -
            tangent.x * 11.0f +
            panX,

            6.0f + lift,

            position.z -
            tangent.z * 11.0f +
            panZ,

            // Target
            position.x +
            tangent.x * 3.0f +
            panX,

            1.8f + lift,

            position.z +
            tangent.z * 3.0f +
            panZ,

            // Up
            0.0f,
            1.0f,
            0.0f
        );
    }

    // ========================================================
    // CAMERA 2 - DRIVER
    // ========================================================

    else if (cameraMode == 1)
    {
        gluLookAt(

            position.x +
            tangent.x * 0.8f +
            panX,

            2.55f + lift,

            position.z +
            tangent.z * 0.8f +
            panZ,

            position.x +
            tangent.x * 20.0f +
            panX,

            2.2f + lift,

            position.z +
            tangent.z * 20.0f +
            panZ,

            0.0f,
            1.0f,
            0.0f
        );
    }

    // ========================================================
    // CAMERA 3 - TOP
    // ========================================================

    else
    {
        float topHeight =
            96.0f + lift;

        if (topHeight < 25.0f)
        {
            topHeight = 25.0f;
        }

        gluLookAt(

            panX,
            topHeight,
            panZ,

            panX,
            0.0f,
            panZ,

            0.0f,
            0.0f,
            -1.0f
        );
    }
}

// ============================================================
// HUD TEXT
// ============================================================

void drawText2D(
    float x,
    float y,
    const char* text
)
{
    glRasterPos2f(
        x,
        y
    );

    while (*text)
    {
        glutBitmapCharacter(
            GLUT_BITMAP_HELVETICA_18,
            *text
        );

        text++;
    }
}

// ============================================================
// HUD
// ============================================================

void drawHUD()
{
    glDisable(GL_LIGHTING);
    glDisable(GL_DEPTH_TEST);

    glMatrixMode(
        GL_PROJECTION
    );

    glPushMatrix();

    glLoadIdentity();

    gluOrtho2D(
        0,
        glutGet(
            GLUT_WINDOW_WIDTH
        ),
        0,
        glutGet(
            GLUT_WINDOW_HEIGHT
        )
    );

    glMatrixMode(
        GL_MODELVIEW
    );

    glPushMatrix();

    glLoadIdentity();

    glColor3f(
        1.0f,
        1.0f,
        1.0f
    );

    char buffer[256];

    sprintf(
        buffer,
        "Speed: %.1f km/h",
        trainSpeed * 3.6f
    );

    drawText2D(
        18,
        145,
        buffer
    );

    sprintf(
        buffer,
        "Throttle: %.0f%%",
        throttle * 100.0f
    );

    drawText2D(
        18,
        120,
        buffer
    );

    sprintf(
        buffer,
        "Brake: %.0f%%",
        brake * 100.0f
    );

    drawText2D(
        18,
        95,
        buffer
    );

    const char* cameraNames[] =
    {
        "Chase",
        "Driver",
        "Top"
    };

    sprintf(
        buffer,
        "Camera: %s",
        cameraNames[cameraMode]
    );

    drawText2D(
        18,
        70,
        buffer
    );

    drawText2D(
        18,
        45,
        "W hold: Speed Up | S hold: Slow Down | B: Brake | N: Release Brake"
    );

    drawText2D(
        18,
        20,
        "C Camera | Arrow Keys Move Camera | 1 Up | 2 Down | R Reset | ESC Exit"
    );

    glPopMatrix();

    glMatrixMode(
        GL_PROJECTION
    );

    glPopMatrix();

    glMatrixMode(
        GL_MODELVIEW
    );

    glEnable(
        GL_DEPTH_TEST
    );

    glEnable(
        GL_LIGHTING
    );
}

// ============================================================
// MANUAL CONTROLS
// ============================================================

void updateControls(float deltaTime)
{
    // --------------------------------------------------------
    // W
    //
    // Holding W:
    // 1. automatically releases brakes
    // 2. progressively increases throttle
    // --------------------------------------------------------

    if (keyW)
    {
        brake = 0.0f;

        throttle +=
            0.55f *
            deltaTime;

        throttle =
            clampValue(
                throttle,
                0.0f,
                1.0f
            );
    }

    // --------------------------------------------------------
    // S
    //
    // Holding S progressively decreases throttle.
    // --------------------------------------------------------

    if (keyS)
    {
        throttle -=
            0.70f *
            deltaTime;

        throttle =
            clampValue(
                throttle,
                0.0f,
                1.0f
            );
    }
}

// ============================================================
// TRAIN PHYSICS
// ============================================================

void updatePhysics()
{
    int currentTime =
        glutGet(
            GLUT_ELAPSED_TIME
        );

    float deltaTime =
        (
            currentTime -
            lastTime
        ) /
        1000.0f;

    lastTime =
        currentTime;

    if (deltaTime > 0.1f)
    {
        deltaTime =
            0.1f;
    }

    // Manual controls
    updateControls(
        deltaTime
    );

    // Engine force
    float engineAcceleration =
        throttle *
        2.7f;

    // Natural rolling resistance
    float rollingResistance =
        0.0f;

    if (trainSpeed > 0.01f)
    {
        rollingResistance =
            0.18f;
    }

    rollingResistance +=
        0.035f *
        trainSpeed;

    rollingResistance +=
        0.0035f *
        trainSpeed *
        trainSpeed;

    // Main brake
    float brakeAcceleration =
        brake *
        7.5f;

    // --------------------------------------------------------
    // S gives extra gentle slowing once throttle reaches zero
    // --------------------------------------------------------

    float gentleSlowdown =
        0.0f;

    if (
        keyS &&
        throttle <= 0.01f
    )
    {
        gentleSlowdown =
            1.1f;
    }

    // Final acceleration
    float acceleration =

        engineAcceleration
        -
        rollingResistance
        -
        brakeAcceleration
        -
        gentleSlowdown;

    trainSpeed +=
        acceleration *
        deltaTime;

    trainSpeed =
        clampValue(
            trainSpeed,
            0.0f,
            MAX_SPEED
        );

    // Completely stop small numerical movement
    if (
        trainSpeed < 0.02f &&
        throttle <= 0.01f
    )
    {
        trainSpeed =
            0.0f;
    }

    // Move forward along railway
    trainDistance +=
        trainSpeed *
        deltaTime;

    trainDistance =
        wrapDistance(
            trainDistance
        );
}

// ============================================================
// LIGHTING
// ============================================================

void setupLighting()
{
    glEnable(
        GL_LIGHTING
    );

    glEnable(
        GL_LIGHT0
    );

    GLfloat lightPosition[] =
    {
        25.0f,
        60.0f,
        20.0f,
        1.0f
    };

    GLfloat diffuse[] =
    {
        0.92f,
        0.92f,
        0.88f,
        1.0f
    };

    GLfloat ambient[] =
    {
        0.26f,
        0.26f,
        0.28f,
        1.0f
    };

    glLightfv(
        GL_LIGHT0,
        GL_POSITION,
        lightPosition
    );

    glLightfv(
        GL_LIGHT0,
        GL_DIFFUSE,
        diffuse
    );

    glLightfv(
        GL_LIGHT0,
        GL_AMBIENT,
        ambient
    );

    glEnable(
        GL_COLOR_MATERIAL
    );

    glColorMaterial(
        GL_FRONT,
        GL_AMBIENT_AND_DIFFUSE
    );
}

// ============================================================
// DISPLAY
// ============================================================

void display()
{
    updatePhysics();

    glClearColor(
        0.58f,
        0.82f,
        0.94f,
        1.0f
    );

    glClear(
        GL_COLOR_BUFFER_BIT |
        GL_DEPTH_BUFFER_BIT
    );

    glMatrixMode(
        GL_MODELVIEW
    );

    glLoadIdentity();

    setCamera();

    setupLighting();

    drawGround();

    drawTrack();

    drawStations();

    drawEnvironment();

    drawTrain();

    drawHUD();

    glutSwapBuffers();

    glutPostRedisplay();
}

// ============================================================
// WINDOW RESIZE
// ============================================================

void reshape(
    int width,
    int height
)
{
    if (height == 0)
    {
        height = 1;
    }

    glViewport(
        0,
        0,
        width,
        height
    );

    glMatrixMode(
        GL_PROJECTION
    );

    glLoadIdentity();

    gluPerspective(
        60.0f,

        (float)width /
        (float)height,

        0.1f,
        260.0f
    );

    glMatrixMode(
        GL_MODELVIEW
    );
}

// ============================================================
// RESET
// ============================================================

void resetSimulation()
{
    trainDistance =
        0.0f;

    trainSpeed =
        0.0f;

    throttle =
        0.0f;

    brake =
        0.0f;

    cameraMode =
        2;

    keyW =
        false;

    keyS =
        false;

    for (
        int i = 0;
        i < 3;
        i++
    )
    {
        camPanX[i] =
            0.0f;

        camPanZ[i] =
            0.0f;

        camLift[i] =
            0.0f;
    }
}

// ============================================================
// NORMAL KEY DOWN
// ============================================================

void keyboardDown(
    unsigned char key,
    int x,
    int y
)
{
    // --------------------------------------------------------
    // W - accelerate
    // --------------------------------------------------------

    if (
        key == 'w' ||
        key == 'W'
    )
    {
        keyW =
            true;

        // IMPORTANT:
        // pressing W after braking automatically releases brake
        brake =
            0.0f;
    }

    // --------------------------------------------------------
    // S - decrease speed
    // --------------------------------------------------------

    else if (
        key == 's' ||
        key == 'S'
    )
    {
        keyS =
            true;
    }

    // --------------------------------------------------------
    // B - full service brake
    // --------------------------------------------------------

    else if (
        key == 'b' ||
        key == 'B'
    )
    {
        throttle =
            0.0f;

        brake =
            1.0f;
    }

    // --------------------------------------------------------
    // N - release brake
    // --------------------------------------------------------

    else if (
        key == 'n' ||
        key == 'N'
    )
    {
        brake =
            0.0f;
    }

    // --------------------------------------------------------
    // C - change camera
    // --------------------------------------------------------

    else if (
        key == 'c' ||
        key == 'C'
    )
    {
        cameraMode++;

        if (
            cameraMode > 2
        )
        {
            cameraMode =
                0;
        }
    }

    // --------------------------------------------------------
    // 1 - camera UP
    // --------------------------------------------------------

    else if (
        key == '1'
    )
    {
        camLift[cameraMode] +=
            2.0f;
    }

    // --------------------------------------------------------
    // 2 - camera DOWN
    // --------------------------------------------------------

    else if (
        key == '2'
    )
    {
        camLift[cameraMode] -=
            2.0f;
    }

    // --------------------------------------------------------
    // R - reset
    // --------------------------------------------------------

    else if (
        key == 'r' ||
        key == 'R'
    )
    {
        resetSimulation();
    }

    // --------------------------------------------------------
    // ESC
    // --------------------------------------------------------

    else if (
        key == 27
    )
    {
        exit(0);
    }
}

// ============================================================
// NORMAL KEY RELEASE
// ============================================================

void keyboardUp(
    unsigned char key,
    int x,
    int y
)
{
    if (
        key == 'w' ||
        key == 'W'
    )
    {
        keyW =
            false;
    }

    if (
        key == 's' ||
        key == 'S'
    )
    {
        keyS =
            false;
    }
}

// ============================================================
// ARROW KEYS
// ============================================================

void specialKeys(
    int key,
    int x,
    int y
)
{
    float movementSpeed =
        2.5f;

    // ========================================================
    // TOP CAMERA
    //
    // Use normal world movement.
    // ========================================================

    if (
        cameraMode == 2
    )
    {
        // Forward
        if (
            key == GLUT_KEY_UP
        )
        {
            camPanZ[2] -=
                movementSpeed;
        }

        // Backward
        if (
            key == GLUT_KEY_DOWN
        )
        {
            camPanZ[2] +=
                movementSpeed;
        }

        // Left
        if (
            key == GLUT_KEY_LEFT
        )
        {
            camPanX[2] -=
                movementSpeed;
        }

        // Right
        if (
            key == GLUT_KEY_RIGHT
        )
        {
            camPanX[2] +=
                movementSpeed;
        }
    }

    // ========================================================
    // CHASE + DRIVER CAMERA
    //
    // Movement is relative to train direction.
    // ========================================================

    else
    {
        Vec2 tangent =
            sampleTrackTangent(
                trainDistance
            );

        Vec2 right =
        {
            tangent.z,
            -tangent.x
        };

        // Forward
        if (
            key == GLUT_KEY_UP
        )
        {
            camPanX[cameraMode] +=
                tangent.x *
                movementSpeed;

            camPanZ[cameraMode] +=
                tangent.z *
                movementSpeed;
        }

        // Backward
        if (
            key == GLUT_KEY_DOWN
        )
        {
            camPanX[cameraMode] -=
                tangent.x *
                movementSpeed;

            camPanZ[cameraMode] -=
                tangent.z *
                movementSpeed;
        }

        // Left
        if (
            key == GLUT_KEY_LEFT
        )
        {
            camPanX[cameraMode] -=
                right.x *
                movementSpeed;

            camPanZ[cameraMode] -=
                right.z *
                movementSpeed;
        }

        // Right
        if (
            key == GLUT_KEY_RIGHT
        )
        {
            camPanX[cameraMode] +=
                right.x *
                movementSpeed;

            camPanZ[cameraMode] +=
                right.z *
                movementSpeed;
        }
    }
}

// ============================================================
// INITIALIZATION
// ============================================================

void initialize()
{
    glEnable(
        GL_DEPTH_TEST
    );

    glShadeModel(
        GL_SMOOTH
    );

    glEnable(
        GL_NORMALIZE
    );

    buildTrack();

    lastTime =
        glutGet(
            GLUT_ELAPSED_TIME
        );
}

// ============================================================
// MAIN
// ============================================================

int main(
    int argc,
    char** argv
)
{
    glutInit(
        &argc,
        argv
    );

    glutInitDisplayMode(
        GLUT_DOUBLE |
        GLUT_RGB |
        GLUT_DEPTH
    );

    glutInitWindowSize(
        1400,
        850
    );

    glutInitWindowPosition(
        50,
        40
    );

    glutCreateWindow(
        "3D Train Simulator - Manual Control - Sketch Layout"
    );

    initialize();

    glutDisplayFunc(
        display
    );

    glutReshapeFunc(
        reshape
    );

    glutKeyboardFunc(
        keyboardDown
    );

    // Needed for HOLD-W / HOLD-S control
    glutKeyboardUpFunc(
        keyboardUp
    );

    glutSpecialFunc(
        specialKeys
    );

    glutMainLoop();

    return 0;
}