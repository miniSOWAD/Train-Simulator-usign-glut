// ============================================================
// UTILITY
// ============================================================

float clampValue(float value, float minimum, float maximum)
{
    if (value < minimum)
        return minimum;

    if (value > maximum)
        return maximum;

    return value;
}

float distance2D(Vec2 a, Vec2 b)
{
    float dx = a.x - b.x;
    float dz = a.z - b.z;

    return sqrtf(dx * dx + dz * dz);
}

Vec2 normalize2D(Vec2 v)
{
    float length =
        sqrtf(v.x * v.x + v.z * v.z);

    if (length < 0.0001f)
    {
        return {0.0f, 0.0f};
    }

    return
    {
        v.x / length,
        v.z / length
    };
}

// ============================================================
// CUBE
// ============================================================

void drawCube(
    float x,
    float y,
    float z,

    float sx,
    float sy,
    float sz,

    float r,
    float g,
    float b
)
{
    glPushMatrix();

    glTranslatef(x, y, z);

    glScalef(
        sx,
        sy,
        sz
    );

    glColor3f(
        r,
        g,
        b
    );

    glutSolidCube(1.0);

    glPopMatrix();
}

// ============================================================
// TRACK GENERATION FUNCTIONS
// ============================================================

void pushTrackPoint(float x, float z)
{
    if (!trackPoints.empty())
    {
        Vec2 last =
            trackPoints.back();

        if (
            distance2D(
                last,
                {x, z}
            ) < 0.01f
        )
        {
            return;
        }
    }

    trackPoints.push_back(
        {x, z}
    );
}

// ------------------------------------------------------------
// STRAIGHT TRACK
// ------------------------------------------------------------

void addLine(
    float x1,
    float z1,

    float x2,
    float z2,

    int samples
)
{
    for (int i = 0; i <= samples; i++)
    {
        float t =
            (float)i /
            (float)samples;

        float x =
            x1 +
            (x2 - x1) * t;

        float z =
            z1 +
            (z2 - z1) * t;

        pushTrackPoint(
            x,
            z
        );
    }
}

// ------------------------------------------------------------
// CIRCULAR TURN
// ------------------------------------------------------------

void addArc(
    float centerX,
    float centerZ,

    float radius,

    float startDegrees,
    float endDegrees,

    int samples
)
{
    for (int i = 0; i <= samples; i++)
    {
        float t =
            (float)i /
            (float)samples;

        float degrees =
            startDegrees +
            (endDegrees - startDegrees) * t;

        float radians =
            degrees * PI / 180.0f;

        float x =
            centerX +
            radius * cosf(radians);

        float z =
            centerZ +
            radius * sinf(radians);

        pushTrackPoint(
            x,
            z
        );
    }
}

// ------------------------------------------------------------
// LARGE SMOOTH OUTER CURVE
//
// This is important because your drawing has a large curved
// left side rather than a tiny semicircle.
// ------------------------------------------------------------

void addBezier(
    Vec2 p0,
    Vec2 p1,
    Vec2 p2,
    Vec2 p3,
    int samples
)
{
    for (int i = 0; i <= samples; i++)
    {
        float t =
            (float)i /
            (float)samples;

        float u =
            1.0f - t;

        float x =
            u * u * u * p0.x +
            3.0f * u * u * t * p1.x +
            3.0f * u * t * t * p2.x +
            t * t * t * p3.x;

        float z =
            u * u * u * p0.z +
            3.0f * u * u * t * p1.z +
            3.0f * u * t * t * p2.z +
            t * t * t * p3.z;

        pushTrackPoint(
            x,
            z
        );
    }
}

// ============================================================
// BUILD TRACK
//
// THIS SECTION DEFINES YOUR DRAWING.
// ============================================================

void buildTrack()
{
    trackPoints.clear();

    // --------------------------------------------------------
    // Your drawing is approximately shaped like:
    //
    //
    //               Station 1
    //
    //       ------------------------------\
    //      /                               |
    //     /                                |
    //    |        _____________            /
    //    |       / Station 2  \___________/
    //    |
    //    |                    _____________\
    //    |                   /              |
    //    |        __________/               /
    //    |       / Station 3  \____________/
    //    |
    //    |                         _________\
    //     \_______________________/          |
    //                                       /
    //          Station 4     <-------------/
    //
    // --------------------------------------------------------

    const float TOP_LEFT_X = -32.0f;
    const float TOP_Z = 30.0f;

    const float RIGHT_TOP_X = 45.0f;

    const float UPPER_Z = 14.0f;
    const float INNER_UPPER_X = -8.0f;

    const float MIDDLE_Z = 2.0f;
    const float RIGHT_MIDDLE_X = 47.0f;

    const float LOWER_Z = -12.0f;
    const float INNER_LOWER_X = -8.0f;

    const float LOWER_SECOND_Z = -24.0f;

    const float RIGHT_BOTTOM_X = 45.0f;

    const float BOTTOM_Z = -38.0f;
    const float BOTTOM_LEFT_X = -32.0f;

    // ========================================================
    // 1. TOP LEFT -> TOP RIGHT
    // ========================================================

    pushTrackPoint(
        TOP_LEFT_X,
        TOP_Z
    );

    addLine(
        TOP_LEFT_X,
        TOP_Z,

        RIGHT_TOP_X,
        TOP_Z,

        80
    );

    // ========================================================
    // 2. TOP-RIGHT LARGE ROUND TURN
    // ========================================================

    addArc(
        RIGHT_TOP_X,
        22.0f,

        8.0f,

        90.0f,
        -90.0f,

        35
    );

    // ========================================================
    // 3. RETURN LEFT TOWARD STATION 2
    // ========================================================

    addLine(
        RIGHT_TOP_X,
        UPPER_Z,

        INNER_UPPER_X,
        UPPER_Z,

        60
    );

    // ========================================================
    // 4. LEFT U-TURN AROUND STATION 2
    //
    // This is the first inner left loop in your drawing.
    // ========================================================

    addArc(
        INNER_UPPER_X,
        8.0f,

        6.0f,

        90.0f,
        270.0f,

        35
    );

    // ========================================================
    // 5. GO RIGHT AGAIN
    // ========================================================

    addLine(
        INNER_UPPER_X,
        MIDDLE_Z,

        RIGHT_MIDDLE_X,
        MIDDLE_Z,

        65
    );

    // ========================================================
    // 6. RIGHT MIDDLE U-TURN
    // ========================================================

    addArc(
        RIGHT_MIDDLE_X,
        -5.0f,

        7.0f,

        90.0f,
        -90.0f,

        35
    );

    // ========================================================
    // 7. COME BACK LEFT TOWARD STATION 3
    // ========================================================

    addLine(
        RIGHT_MIDDLE_X,
        LOWER_Z,

        INNER_LOWER_X,
        LOWER_Z,

        65
    );

    // ========================================================
    // 8. LEFT U-TURN AROUND STATION 3
    // ========================================================

    addArc(
        INNER_LOWER_X,
        -18.0f,

        6.0f,

        90.0f,
        270.0f,

        35
    );

    // ========================================================
    // 9. GO RIGHT AGAIN
    // ========================================================

    addLine(
        INNER_LOWER_X,
        LOWER_SECOND_Z,

        RIGHT_BOTTOM_X,
        LOWER_SECOND_Z,

        65
    );

    // ========================================================
    // 10. BOTTOM-RIGHT TURN
    // ========================================================

    addArc(
        RIGHT_BOTTOM_X,
        -31.0f,

        7.0f,

        90.0f,
        -90.0f,

        35
    );

    // ========================================================
    // 11. LONG BOTTOM SECTION
    //
    // Like the long bottom line in your drawing.
    // ========================================================

    addLine(
        RIGHT_BOTTOM_X,
        BOTTOM_Z,

        BOTTOM_LEFT_X,
        BOTTOM_Z,

        85
    );

    // ========================================================
    // 12. HUGE OUTER LEFT CURVE
    //
    // THIS was missing before.
    //
    // It gives the large left boundary from your drawing.
    // ========================================================

    addBezier(
        {
            BOTTOM_LEFT_X,
            BOTTOM_Z
        },

        {
            -61.0f,
            -40.0f
        },

        {
            -62.0f,
            29.0f
        },

        {
            TOP_LEFT_X,
            TOP_Z
        },

        100
    );

    // ========================================================
    // BUILD DISTANCE TABLE
    // ========================================================

    cumulativeLength.clear();

    cumulativeLength.push_back(
        0.0f
    );

    for (
        size_t i = 1;
        i < trackPoints.size();
        i++
    )
    {
        float segment =
            distance2D(
                trackPoints[i - 1],
                trackPoints[i]
            );

        cumulativeLength.push_back(
            cumulativeLength.back() +
            segment
        );
    }

    totalTrackLength =
        cumulativeLength.back();
}

// ============================================================
// TRACK SAMPLING
// ============================================================

float wrapDistance(float distance)
{
    while (distance < 0.0f)
    {
        distance +=
            totalTrackLength;
    }

    while (
        distance >=
        totalTrackLength
    )
    {
        distance -=
            totalTrackLength;
    }

    return distance;
}

Vec2 sampleTrackPosition(float distance)
{
    distance =
        wrapDistance(distance);

    for (
        size_t i = 0;
        i < cumulativeLength.size() - 1;
        i++
    )
    {
        if (
            distance >= cumulativeLength[i] &&
            distance <= cumulativeLength[i + 1]
        )
        {
            float segmentLength =
                cumulativeLength[i + 1] -
                cumulativeLength[i];

            float t;

            if (segmentLength < 0.0001f)
            {
                t = 0.0f;
            }
            else
            {
                t =
                    (distance -
                     cumulativeLength[i]) /
                    segmentLength;
            }

            Vec2 a =
                trackPoints[i];

            Vec2 b =
                trackPoints[i + 1];

            return
            {
                a.x +
                (b.x - a.x) * t,

                a.z +
                (b.z - a.z) * t
            };
        }
    }

    return
        trackPoints.back();
}

Vec2 sampleTrackTangent(float distance)
{
    Vec2 before =
        sampleTrackPosition(
            distance - 0.35f
        );

    Vec2 after =
        sampleTrackPosition(
            distance + 0.35f
        );

    return normalize2D(
        {
            after.x - before.x,
            after.z - before.z
        }
    );
}

// ============================================================
// GROUND
// ============================================================

void drawGround()
{
    glDisable(GL_LIGHTING);

    glColor3f(
        0.70f,
        0.90f,
        0.58f
    );

    glBegin(GL_QUADS);

    glVertex3f(
        -85.0f,
        -0.15f,
        -55.0f
    );

    glVertex3f(
        85.0f,
        -0.15f,
        -55.0f
    );

    glVertex3f(
        85.0f,
        -0.15f,
        55.0f
    );

    glVertex3f(
        -85.0f,
        -0.15f,
        55.0f
    );

    glEnd();

    // Grid

    glColor3f(
        0.43f,
        0.73f,
        0.33f
    );

    glBegin(GL_LINES);

    for (
        int x = -80;
        x <= 80;
        x += 8
    )
    {
        glVertex3f(
            (float)x,
            -0.14f,
            -55.0f
        );

        glVertex3f(
            (float)x,
            -0.14f,
            55.0f
        );
    }

    for (
        int z = -48;
        z <= 48;
        z += 8
    )
    {
        glVertex3f(
            -85.0f,
            -0.14f,
            (float)z
        );

        glVertex3f(
            85.0f,
            -0.14f,
            (float)z
        );
    }

    glEnd();

    glEnable(GL_LIGHTING);
}

// ============================================================
// TRACK NORMAL / TANGENT
// ============================================================

Vec2 pointTangent(size_t index)
{
    size_t count =
        trackPoints.size();

    size_t previous;

    size_t next;

    if (index == 0)
    {
        previous =
            count - 2;
    }
    else
    {
        previous =
            index - 1;
    }

    if (index >= count - 1)
    {
        next = 1;
    }
    else
    {
        next =
            index + 1;
    }

    return normalize2D(
        {
            trackPoints[next].x -
            trackPoints[previous].x,

            trackPoints[next].z -
            trackPoints[previous].z
        }
    );
}

// ============================================================
// DRAW TRACK
// ============================================================

void drawTrack()
{
    // --------------------------------------------------------
    // Ballast
    // --------------------------------------------------------

    glDisable(GL_LIGHTING);

    glColor3f(
        0.82f,
        0.82f,
        0.80f
    );

    glBegin(GL_QUAD_STRIP);

    for (
        size_t i = 0;
        i < trackPoints.size();
        i++
    )
    {
        Vec2 tangent =
            pointTangent(i);

        Vec2 normal =
        {
            -tangent.z,
            tangent.x
        };

        float width =
            1.75f;

        glVertex3f(
            trackPoints[i].x +
            normal.x * width,

            0.02f,

            trackPoints[i].z +
            normal.z * width
        );

        glVertex3f(
            trackPoints[i].x -
            normal.x * width,

            0.02f,

            trackPoints[i].z -
            normal.z * width
        );
    }

    glEnd();

    // --------------------------------------------------------
    // Rails
    // --------------------------------------------------------

    glLineWidth(3.0f);

    glColor3f(
        0.12f,
        0.12f,
        0.14f
    );

    for (
        int side = -1;
        side <= 1;
        side += 2
    )
    {
        glBegin(GL_LINE_STRIP);

        for (
            size_t i = 0;
            i < trackPoints.size();
            i++
        )
        {
            Vec2 tangent =
                pointTangent(i);

            Vec2 normal =
            {
                -tangent.z,
                tangent.x
            };

            float offset =
                0.60f * side;

            glVertex3f(
                trackPoints[i].x +
                normal.x * offset,

                0.14f,

                trackPoints[i].z +
                normal.z * offset
            );
        }

        glEnd();
    }

    glEnable(GL_LIGHTING);

    // --------------------------------------------------------
    // Sleepers
    // --------------------------------------------------------

    for (
        float d = 0.0f;
        d < totalTrackLength;
        d += 1.8f
    )
    {
        Vec2 position =
            sampleTrackPosition(d);

        Vec2 tangent =
            sampleTrackTangent(d);

        float angle =
            atan2f(
                tangent.x,
                tangent.z
            ) * 180.0f / PI;

        glPushMatrix();

        glTranslatef(
            position.x,
            0.05f,
            position.z
        );

        glRotatef(
            angle,
            0.0f,
            1.0f,
            0.0f
        );

        glScalef(
            2.1f,
            0.12f,
            0.28f
        );

        glColor3f(
            0.35f,
            0.20f,
            0.07f
        );

        glutSolidCube(1.0);

        glPopMatrix();
    }
}

// ============================================================
// TRAIN WHEELS
// ============================================================

